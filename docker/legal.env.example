# `.\jokester.ps1 legal` 的输入（复制为 docker/legal.env）。只在执行该命令时注入 API 容器，
# 先写 web 再写 all。URL 必须是可匿名访问的 HTTPS 地址；Approved=true 表示操作者确认
# 本次版本与 URL 已经过业务/法务审批。部署专属版本和 URL 不提交到仓库。
LegalDocuments__Approved=false
LegalDocuments__Locale=zh-CN
LegalDocuments__EffectiveAt=2026-01-01T00:00:00Z
LegalDocuments__PrivacyPolicy__Version=
LegalDocuments__PrivacyPolicy__Url=
LegalDocuments__PrivacyPolicy__RequiresReconsent=false
LegalDocuments__TermsOfService__Version=
LegalDocuments__TermsOfService__Url=
LegalDocuments__TermsOfService__RequiresReconsent=false
# 暂不启用 AI 告知时设为 false（此时所有 AI 生图入口返回 503）。
LegalDocuments__AiProcessing__Enabled=true
LegalDocuments__AiProcessing__Version=
LegalDocuments__AiProcessing__Url=
LegalDocuments__AiProcessing__RequiresReconsent=true
LegalDocuments__AiProcessing__ProviderCodes__0=openai
LegalDocuments__AiProcessing__ProviderCodes__1=google
