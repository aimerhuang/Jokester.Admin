# API 业务配置（ASP.NET Core 环境变量）。复制为 docker/api.env 后使用；
# `.\jokester.ps1 init` 会自动复制并生成 __RANDOM__ 位置的随机密钥。
#
# 以下键由 compose.yaml 统一生成，这里不要配置（配置了也会被覆盖）：
#   ASPNETCORE_URLS、AllowedHosts、Security__AllowedOrigins__0、Security__KnownProxies__0、
#   Database__*、Redis__ConnectionString、AiMediaStorage__RootPath、PROMPT_IMAGE_ROOT
# 值只支持单行；多行 PEM 等密钥请用 Docker secret 或部署平台注入。

ASPNETCORE_ENVIRONMENT=Production
Swagger__Enabled=true

# 额外允许的浏览器来源（例如本机 vite 开发服务器直连 API 时）。
Security__AllowedOrigins__1=http://localhost:5173

Jwt__Issuer=http://localhost:8080
Jwt__Audience=jokester-app
Jwt__SecretKey=__RANDOM__
Jwt__AccessTokenExpiresMinutes=15
Jwt__RefreshTokenExpiresDays=7

Redis__InstanceName=jokester-admin:
Redis__EnableInMemoryRefreshTokenFallback=false

# 本地默认发到 Mailpit（http://localhost:8025 查看邮件）。
# 改用 163 SMTP：Mail__Host=smtp.163.com、Mail__Port=587、Mail__SecureSocketOptions=StartTls，
# 并填写 UserName / Password(SMTP 授权码) / FromAddress。
Mail__Host=mailpit
Mail__Port=1025
Mail__SecureSocketOptions=None
Mail__UserName=
Mail__Password=
Mail__FromAddress=no-reply@jokester.local
Mail__FromName=Jokester

EmailValidation__EnableApiValidation=false
EmailValidation__ApiEndpoint=
EmailValidation__ApiKey=
EmailValidation__ApiKeyHeaderName=Authorization

# `.\jokester.ps1 seed-admin` 会交互输入账号密码，不需要写在这里。
BootstrapAdmin__UserName=
BootstrapAdmin__Password=
BootstrapAdmin__Secret=__RANDOM__

OpenAI__PrimaryTimeoutSeconds=180

# size-mode-v1 保持关闭，直到 catalog、路由和价格完成审批发布。
AiImageSizeMode__Enabled=false
AiImageSizeMode__AutoEnabled=false
AiImageSizeMode__AutoCohortPercent=0
AiImageSizeMode__ProviderAllowedHosts__0=api.openai.com
AiImageSizeMode__AttemptReconcileMinutes=30
AiImageCatalogRelease__Approved=false

AiPromptFilter__Enabled=true
AiPromptFilter__RefreshIntervalSeconds=30
AiPromptFilter__MaxSnapshotAgeMinutes=15
AiPromptFilter__MinimumActiveWordCount=1

AiCostControl__DailyImageLimitPerUser=20
AiCostControl__DailyPointLimitPerUser=1000
AiCostControl__MaxConcurrentTasksPerUser=10
AiCostControl__MaxQueuedTasks=20
AiCostControl__MaxGlobalProviderConcurrency=4
AiCostControl__IdempotencyTtlHours=24
AiCostControl__ReservationTtlMinutes=1440
AiCostControl__ProviderLeaseSeconds=660
AiCostControl__ProviderFailureThreshold=5
AiCostControl__ProviderFailureWindowSeconds=300
AiCostControl__ProviderCircuitOpenSeconds=60
AiCostControl__OutboxBindDeadlineMinutes=120

AppleAppStore__Enabled=false
Mobile__MinimumSupportedVersion=0.0.0
Mobile__LatestVersion=0.0.0
Mobile__MaintenanceMode=false
Mobile__Features__AppleIap=false
Mobile__Features__AccountDeletion=true
Mobile__Features__PromptLibrary=false

# 提示词库同步（图片目录由编排固定为 /data/prompt-images）。
PROMPT_LIBRARY_ENABLED=false
PROMPT_SOURCE_API_URL=https://raw.githubusercontent.com/YouMind-OpenLab/awesome-gpt-image-2/589f148fd605574569580665403311c5eb88143e/README_zh.md
PROMPT_SOURCE_API_TOKEN=
PROMPT_TARGET_COUNT=126
PROMPT_SYNC_CRON=0 30 2,14 * * *
PROMPT_SYNC_HTTP_PROXY=
PROMPT_IMAGE_PUBLIC_BASE=/prompt-images
PROMPT_IMAGE_MAX_BYTES=15728640
PROMPT_IMAGE_RETAIN_DAYS=7
PROMPT_IMAGE_ALLOWED_HOSTS=cms-assets.youmind.com,marketing-assets.youmind.com
PROMPT_KEEP_SNAPSHOTS=2
PROMPT_DOWNLOAD_CONCURRENCY=4
