# Docker Compose 变量（编排层）。复制为 docker/.env 后使用；
# `.\jokester.ps1 init` 会自动复制并生成 __RANDOM__ 位置的随机密钥。
# 业务配置不放这里，放 api.env。

# 在 docker/ 目录直接执行 docker compose 时自动组合这两个文件。
COMPOSE_PROJECT_NAME=jokester-local
COMPOSE_PATH_SEPARATOR=;
COMPOSE_FILE=compose.yaml;compose.local.yaml

TZ=Asia/Shanghai

# 对外访问地址：AllowedHosts、CORS、API 健康检查都由这里派生。
APP_DOMAIN=localhost
PUBLIC_ORIGIN=http://localhost:8080
WEB_BIND=127.0.0.1
WEB_PORT=8080

# 内部网络；web 使用固定 IP，API 只信任它转发的客户端 IP。
# 与本机其他网络冲突时两项一起修改。
DOCKER_SUBNET=172.30.0.0/24
WEB_IPV4=172.30.0.10

API_IMAGE=jokester-admin:local
WEB_IMAGE=jokester-web:local

# 不要在密码里使用分号或逗号，会破坏连接串。
MYSQL_IMAGE=mysql:8.4
MYSQL_DATABASE=jokester_admin
MYSQL_USER=jokester
MYSQL_PASSWORD=__RANDOM__
MYSQL_ROOT_PASSWORD=__RANDOM__
MYSQL_TIME_ZONE=+08:00
# 首次初始化时，若此目录内有 *.sql（如 mysqldump 导出），按文件名顺序导入，
# 不再执行 jokester.admin.sql。
MYSQL_IMPORT_DIR=./mysql/import

REDIS_IMAGE=redis:7.4-alpine
REDIS_PASSWORD=__RANDOM__

# ---- 以下仅本地测试使用（compose.local.yaml） ----
FRONTEND_DIR=../../Jokester-Ai-Image
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380
API_HOST_PORT=5050
MAILPIT_UI_PORT=8025

# 构建基础镜像与 npm 源，网络受限时可替换为镜像加速地址。
DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0
DOTNET_ASPNET_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0
NODE_IMAGE=node:24-alpine
NGINX_IMAGE=nginx:1.28-alpine
NPM_REGISTRY=
MAILPIT_IMAGE=axllent/mailpit:latest
