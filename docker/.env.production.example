# 生产服务器的编排变量（部署目录下的 .env，权限 600）。
# 全新服务器：./jokester.sh init production；从旧 Caddy 部署迁移：./jokester.sh migrate-from-caddy。
# API_IMAGE / WEB_IMAGE 由发布脚本自动更新，不需要手工修改。

COMPOSE_PROJECT_NAME=jokester-admin
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=compose.yaml:compose.production.yaml

TZ=Asia/Shanghai

APP_DOMAIN=johhai.com
PUBLIC_ORIGIN=https://johhai.com
WEB_BIND=0.0.0.0
WEB_PORT=80
WEB_HTTPS_BIND=0.0.0.0
WEB_HTTPS_PORT=443

# HTTPS 在 nginx 终止；证书放在 TLS_CERT_DIR/tls.crt 与 tls.key。
TLS_MODE=on
TLS_CERT_DIR=./certs
# 站点经过 Cloudflare 代理时使用 cloudflare，否则 none。
REAL_IP_MODE=cloudflare

# 与旧部署保持一致，便于原地迁移。
DOCKER_SUBNET=172.29.0.0/24
WEB_IPV4=172.29.0.10

API_IMAGE=
WEB_IMAGE=

MYSQL_IMAGE=mysql:8.4
MYSQL_DATABASE=jokester_admin
MYSQL_USER=jokester
MYSQL_PASSWORD=__RANDOM__
MYSQL_ROOT_PASSWORD=__RANDOM__
MYSQL_TIME_ZONE=+08:00
MYSQL_SCHEMA_FILE=./jokester.admin.sql
MYSQL_IMPORT_DIR=./mysql/import

REDIS_IMAGE=redis:7.4-alpine
REDIS_PASSWORD=__RANDOM__

LOG_MAX_SIZE=20m
LOG_MAX_FILE=5
