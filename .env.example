ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5049
Swagger__Enabled=false

Jwt__Issuer=https://api.example.com
Jwt__Audience=jokester-app
Jwt__SecretKey=replace-with-a-32-byte-minimum-production-secret
Jwt__AccessTokenExpiresMinutes=15
Jwt__RefreshTokenExpiresDays=7

Database__Provider=MySql
Database__ConnectionString=server=localhost;Database=jokester.admin;Uid=replace-me;Pwd=replace-me;Port=3306;Allow User Variables=True;SslMode=None;AllowPublicKeyRetrieval=True;

Redis__ConnectionString=localhost:6379,abortConnect=false
Redis__InstanceName=jokester-admin
Redis__EnableInMemoryRefreshTokenFallback=false

Mail__Host=smtp.163.com
Mail__Port=587
Mail__UseSsl=false
Mail__SecureSocketOptions=StartTls
Mail__UserName=replace-me@example.com
Mail__Password=replace-with-smtp-authorization-code
Mail__FromAddress=replace-me@example.com
Mail__FromName=Jokester

EmailValidation__EnableApiValidation=false
EmailValidation__ApiEndpoint=
EmailValidation__ApiKey=
EmailValidation__ApiKeyHeaderName=Authorization

OpenAI__PrimaryTimeoutSeconds=120

AiPromptFilter__Enabled=true
AiPromptFilter__RefreshIntervalSeconds=30
AiPromptFilter__MaxSnapshotAgeMinutes=15
AiPromptFilter__MinimumActiveWordCount=1

# Optional absolute path. Leave empty to discover the repository-level private-media/ai directory.
AiMediaStorage__RootPath=

# Apple IAP is disabled until all credentials and product mappings are configured.
# Inject AppleAppStore__PrivateKeyPem through Secret Manager or a deployment secret
# that preserves PEM newlines; this repository's simple .env loader is single-line.
AppleAppStore__Enabled=false
AppleAppStore__BundleId=
AppleAppStore__IssuerId=
AppleAppStore__KeyId=
AppleAppStore__PrivateKeyPem=
AppleAppStore__AppAccountTokenKey=
AppleAppStore__Environment=Production
AppleAppStore__ProductionBaseUrl=https://api.storekit.itunes.apple.com
AppleAppStore__SandboxBaseUrl=https://api.storekit-sandbox.itunes.apple.com

Mobile__MinimumSupportedVersion=0.0.0
Mobile__LatestVersion=0.0.0
Mobile__MaintenanceMode=false
Mobile__Features__AppleIap=true
Mobile__Features__AccountDeletion=true
Mobile__Features__PromptLibrary=true

BootstrapAdmin__UserName=replace-me
BootstrapAdmin__Password=replace-with-strong-password
BootstrapAdmin__Secret=replace-with-bootstrap-secret

# Production must configure explicit browser origins and trusted reverse proxies.
AiCostControl__DailyImageLimitPerUser=20
AiCostControl__DailyPointLimitPerUser=1000
AiCostControl__MaxConcurrentTasksPerUser=10
AiCostControl__MaxQueuedTasks=20
AiCostControl__MaxGlobalProviderConcurrency=4
AiCostControl__IdempotencyTtlHours=24
AiCostControl__ReservationTtlMinutes=1440
AiCostControl__ProviderLeaseSeconds=660
AiCostControl__ProviderFailureThreshold=5
AiCostControl__ProviderFailureWindowSeconds=300
AiCostControl__ProviderCircuitOpenSeconds=60

Security__AllowedOrigins__0=https://app.example.com
Security__KnownProxies__0=127.0.0.1

# Prompt library synchronization. PROMPT_IMAGE_ROOT must be outside the publish directory
# and must match the Nginx /prompt-images/ alias target.
PROMPT_LIBRARY_ENABLED=false
PROMPT_SOURCE_API_URL=https://raw.githubusercontent.com/YouMind-OpenLab/awesome-gpt-image-2/589f148fd605574569580665403311c5eb88143e/README_zh.md
PROMPT_SOURCE_API_TOKEN=
PROMPT_TARGET_COUNT=126
PROMPT_SYNC_CRON=0 30 2,14 * * *
PROMPT_SYNC_HTTP_PROXY=
PROMPT_SYNC_CONNECT_TIMEOUT_SECONDS=10
PROMPT_SYNC_TOTAL_TIMEOUT_SECONDS=600
PROMPT_SYNC_RETRY_COUNT=3
PROMPT_IMAGE_ROOT=/var/lib/jokester/prompt-images
PROMPT_IMAGE_PUBLIC_BASE=/prompt-images
PROMPT_IMAGE_MAX_BYTES=15728640
PROMPT_IMAGE_RETAIN_DAYS=7
PROMPT_IMAGE_ALLOWED_HOSTS=cms-assets.youmind.com,marketing-assets.youmind.com
PROMPT_KEEP_SNAPSHOTS=2
PROMPT_DOWNLOAD_CONCURRENCY=4
